{
  "name": "@local/dsh-mcp-manager-ui",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Manage native DSH MCP servers using guided individual fields, user notes, and safe configuration persistence.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/null0xfff/dsh-mcp-manager.git" },
  "homepage": "https://github.com/null0xfff/dsh-mcp-manager",
  "bugs": { "url": "https://github.com/null0xfff/dsh-mcp-manager/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "mcp", "mcp-manager", "model-context-protocol", "cordis"],
  "engines": { "dsh": "0.2.2-rc.5" },
  "exports": {
    ".": "./release-1.1.2-host.js",
    "./client": "./release-1.1.2-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["release-1.1.2-host.js", "release-1.1.2-management.js", "release-1.1.2-config.js", "release-1.1.2-notes.js", "release-1.1.2-client.js", "index.js", "management.js", "notes.js", "config.js", "client.js", "form-model.js", "build-release.mjs", "cordis.patch.yml", "locale/*.json", "README.md", "LICENSE", "icon.svg"],
  "dependencies": { "yaml": "2.8.1", "zod": "4.6.6" },
  "scripts": { "test": "node --test tests/*.test.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
